{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\" || exit 2",
            "statusMessage": "guard: checking the call against the project rules"
          }
        ]
      }
    ]
  }
}
