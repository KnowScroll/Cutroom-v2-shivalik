  },
  "dependencies": {
    "@cutroom/foundations": "0.0.0",
    "@cutroom/project-core": "0.0.0",
    "@cutroom/compiler": "0.0.0",
    "@cutroom/scheduler": "0.0.0",
    "@cutroom/render": "0.0.0",
    "@cutroom/harness": "0.0.0",
    "@cutroom/studio": "0.0.0",
    "@cutroom/quality": "0.0.0"
  }
